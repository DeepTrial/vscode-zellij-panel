{
  "name": "vscode-zellij-panel",
  "displayName": "Zellij Panel for VS Code",
  "publisher": "DeepTrial",
  "repository": {
    "type": "git",
    "url": "https://github.com/DeepTrial/vscode-zellij-panel.git"
  },
  "description": "Run Zellij in a Pseudoterminal-backed panel and visualize Claude Code file edits via hooks + file watching.",
  "version": "0.1.0",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:vscode-zellij-panel.open",
    "onCommand:vscode-zellij-panel.installHook",
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "zellij-panel",
          "title": "Zellij Panel",
          "icon": "$(terminal)"
        }
      ]
    },
    "views": {
      "zellij-panel": [
        {
          "id": "zellij-panel.actions",
          "name": "Actions"
        }
      ]
    },
    "commands": [
      {
        "command": "vscode-zellij-panel.open",
        "title": "Zellij Panel: Open Session",
        "category": "Zellij Panel",
        "icon": "$(terminal)"
      },
      {
        "command": "vscode-zellij-panel.installHook",
        "title": "Zellij Panel: Install Claude Code Hook",
        "category": "Zellij Panel",
        "icon": "$(tools)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "vscode-zellij-panel.open",
          "when": "view == zellij-panel.actions",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "vscode-zellij-panel.open",
          "group": "zellij@1"
        },
        {
          "command": "vscode-zellij-panel.installHook",
          "group": "zellij@2"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "zellij-panel.actions",
        "contents": "No session open yet.\n[Open Zellij Session](command:vscode-zellij-panel.open)",
        "when": "true"
      }
    ],
    "configuration": {
      "title": "Zellij Panel",
      "properties": {
        "vscode-zellij-panel.sessionMode": {
          "type": "string",
          "enum": [
            "new",
            "attach"
          ],
          "default": "new",
          "description": "new = create a fresh Zellij session; attach = attach to an existing session name."
        },
        "vscode-zellij-panel.attachName": {
          "type": "string",
          "default": "",
          "description": "Zellij session name to attach when sessionMode is 'attach'."
        },
        "vscode-zellij-panel.listenClaude": {
          "type": "boolean",
          "default": true,
          "description": "When true, listen for Claude Code edits via local hook server + file watching and show diffs. When false, the panel only runs Zellij without edit capture."
        },
        "vscode-zellij-panel.hookPort": {
          "type": "number",
          "default": 3910,
          "description": "Port for the local Claude Code hook receiver."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "node ./dist/test/runTest.js",
    "package": "vsce package",
    "lint": "tsc -p ./ --noEmit"
  },
  "dependencies": {
    "node-pty": "^1.0.0"
  },
  "devDependencies": {
    "@types/glob": "^8.1.0",
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.0.0",
    "@types/vscode": "1.85.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^2.24.0",
    "glob": "^10.3.10",
    "mocha": "^10.3.0",
    "typescript": "^5.4.0"
  }
}
